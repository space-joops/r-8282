# data.go.kr 마이페이지 > 개발계정 상세의 일반 인증키를 넣으세요.
# Encoding/Decoding 어느 쪽 키를 넣어도 됩니다 (자동 판별).
# 이 파일을 .env로 복사한 뒤 값을 채우면 됩니다. (.env는 gitignore 대상)
KRA_SERVICE_KEY=

# Supabase 운영 텔레메트리 (선택 — 비워두면 기록을 건너뜀)
# Supabase 대시보드 > Settings > API의 Project URL과 service_role(또는 secret) 키.
# Vercel Marketplace 연동 값(SUPABASE_SERVICE_ROLE_KEY 이름)을 그대로 넣어도 인식됨.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
