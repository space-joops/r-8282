{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kra-predict/backtest.schema.json",
  "title": "Backtest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "models": { "type": "array", "items": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "dateStr": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["races", "winHits", "winRate", "placeHits", "placeRate", "top3ExactHits", "logLoss", "roiWin", "roiPlace"],
      "properties": {
        "races": { "type": "integer", "minimum": 0 },
        "winHits": { "type": "integer", "minimum": 0 },
        "winRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "placeHits": { "type": "integer", "minimum": 0 },
        "placeRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "top3ExactHits": { "type": "integer", "minimum": 0 },
        "logLoss": { "type": ["number", "null"] },
        "roiWin": { "type": ["number", "null"] },
        "roiPlace": { "type": ["number", "null"] }
      }
    },
    "monthlyMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "races", "winHits", "winRate", "placeHits", "placeRate", "top3ExactHits", "logLoss", "roiWin", "roiPlace"],
      "properties": {
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "races": { "type": "integer", "minimum": 0 },
        "winHits": { "type": "integer", "minimum": 0 },
        "winRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "placeHits": { "type": "integer", "minimum": 0 },
        "placeRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "top3ExactHits": { "type": "integer", "minimum": 0 },
        "logLoss": { "type": ["number", "null"] },
        "roiWin": { "type": ["number", "null"] },
        "roiPlace": { "type": ["number", "null"] }
      }
    },
    "bettingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "label", "bets", "hits", "hitRate", "stakeKrw", "returnedKrw", "profitKrw", "roi"],
      "properties": {
        "pool": { "enum": ["WIN", "PLC", "QNL", "EXA", "QPL", "TLA", "TRI"] },
        "label": { "type": "string" },
        "bets": { "type": "integer", "minimum": 0 },
        "hits": { "type": "integer", "minimum": 0 },
        "hitRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "stakeKrw": { "type": "integer", "minimum": 0 },
        "returnedKrw": { "type": "integer", "minimum": 0 },
        "profitKrw": { "type": "integer" },
        "roi": { "type": ["number", "null"] }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generatedAt", "periodFrom", "periodTo", "note", "overall", "byTrack", "byConfidence", "monthly", "betting"],
      "properties": {
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "periodFrom": { "$ref": "#/$defs/dateStr" },
        "periodTo": { "$ref": "#/$defs/dateStr" },
        "note": { "type": "string" },
        "overall": { "$ref": "#/$defs/metric" },
        "byTrack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seoul", "busan", "jeju"],
          "properties": {
            "seoul": { "$ref": "#/$defs/metric" },
            "busan": { "$ref": "#/$defs/metric" },
            "jeju": { "$ref": "#/$defs/metric" }
          }
        },
        "byConfidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "medium", "low"],
          "properties": {
            "high": { "$ref": "#/$defs/metric" },
            "medium": { "$ref": "#/$defs/metric" },
            "low": { "$ref": "#/$defs/metric" }
          }
        },
        "monthly": { "type": "array", "items": { "$ref": "#/$defs/monthlyMetric" } },
        "betting": { "type": "array", "items": { "$ref": "#/$defs/bettingEntry" } }
      }
    }
  }
}
